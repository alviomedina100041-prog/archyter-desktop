unsafe fn draw_findings(dc:HDC,state:&AppState,r:R){
    panel(dc,r,state.theme.panel,state.theme.border,6); text(dc,&state.ui,"♟  Findings Summary",R{x:r.x+12,y:r.y+4,w:r.w-24,h:30},state.theme.text,FontKind::Normal,DT_LEFT|DT_VCENTER|DT_SINGLELINE);
    let counts=state.case.severity_counts(); let gap=6; let card_w=(r.w-24-gap*3)/4; let labels=[("Critical",counts[0],state.theme.red),("High",counts[1],state.theme.orange),("Medium",counts[2],state.theme.yellow),("Low",counts[3],state.theme.blue)];
    for (i,(label,count,color)) in labels.iter().enumerate(){let c=R{x:r.x+8+i as i32*(card_w+gap),y:r.y+38,w:card_w,h:62};fill(dc,c,rgb(12,20,24));stroke(dc,c,*color,1,5);text(dc,&state.ui,&count.to_string(),R{x:c.x,y:c.y+6,w:c.w,h:28},*color,FontKind::Big,DT_CENTER|DT_SINGLELINE);text(dc,&state.ui,label,R{x:c.x,y:c.y+36,w:c.w,h:20},*color,FontKind::Small,DT_CENTER|DT_SINGLELINE);}
    text(dc,&state.ui,"Top Findings",R{x:r.x+10,y:r.y+108,w:120,h:22},state.theme.text,FontKind::Small,DT_LEFT|DT_SINGLELINE); text(dc,&state.ui,"View All",R{x:r.right()-70,y:r.y+108,w:58,h:22},state.theme.muted,FontKind::Small,DT_RIGHT|DT_SINGLELINE);
    let mut y=r.y+134; for f in state.case.findings.iter().take(5){let color=sev_color(state.theme,f.severity);dot(dc,r.x+15,y+8,6,color);text(dc,&state.ui,&f.title,R{x:r.x+30,y,w:r.w-150,h:19},state.theme.text,FontKind::Small,DT_LEFT|DT_SINGLELINE|DT_END_ELLIPSIS);let pill=R{x:r.right()-118,y:y-2,w:75,h:21};stroke(dc,pill,color,1,8);text(dc,&state.ui,f.severity.label(),pill,color,FontKind::Small,DT_CENTER|DT_VCENTER|DT_SINGLELINE);text(dc,&state.ui,&f.count.to_string(),R{x:r.right()-35,y,w:23,h:19},state.theme.text,FontKind::Small,DT_RIGHT|DT_SINGLELINE);y+=24;}
}

unsafe fn draw_timeline(dc:HDC,state:&AppState,r:R){
    panel(dc,r,state.theme.panel,state.theme.border,6); text(dc,&state.ui,"◉  Timeline",R{x:r.x+12,y:r.y+4,w:120,h:30},state.theme.text,FontKind::Normal,DT_LEFT|DT_VCENTER|DT_SINGLELINE);
    let filter_names=["All","File","System","Network","Database"]; let mut fx=r.right()-255; for (i,n) in filter_names.iter().enumerate(){let w=if i==0{38}else{52};let fr=R{x:fx,y:r.y+7,w,h:25};if i==0{fill(dc,fr,rgb(4,48,31));stroke(dc,fr,state.theme.green,1,5);}else{stroke(dc,fr,state.theme.border,1,5);}text(dc,&state.ui,n,fr,if i==0{state.theme.green}else{state.theme.muted},FontKind::Small,DT_CENTER|DT_VCENTER|DT_SINGLELINE);fx+=w+4;}
    let mut y=r.y+45; for e in state.case.timeline.iter().rev().take(((r.h-50)/22) as usize).rev(){let color=sev_color(state.theme,e.severity);dot(dc,r.x+18,y+7,5,color);text(dc,&state.ui,&e.time,R{x:r.x+31,y,w:58,h:18},state.theme.muted,FontKind::Small,DT_LEFT|DT_SINGLELINE);text(dc,&state.ui,&e.message,R{x:r.x+92,y,w:r.w-182,h:18},state.theme.text,FontKind::Small,DT_LEFT|DT_SINGLELINE|DT_END_ELLIPSIS);text(dc,&state.ui,&e.category,R{x:r.right()-86,y,w:74,h:18},state.theme.muted,FontKind::Small,DT_RIGHT|DT_SINGLELINE|DT_END_ELLIPSIS);y+=22;}
}

unsafe fn draw_right_bottom(dc:HDC,state:&AppState,r:R){
    let hex=R{x:r.x,y:r.y,w:r.w,h:134.min(r.h/2)}; panel(dc,hex,state.theme.panel,state.theme.border,6); text(dc,&state.ui,"▣  Hex Preview  (disk01.E01)",R{x:hex.x+12,y:hex.y+4,w:hex.w-50,h:28},state.theme.text,FontKind::Normal,DT_LEFT|DT_VCENTER|DT_SINGLELINE); text(dc,&state.ui,"Offset: 0x00000000",R{x:hex.x+10,y:hex.y+35,w:170,h:18},state.theme.muted,FontKind::MonoSmall,DT_LEFT|DT_SINGLELINE);text(dc,&state.ui,"ASCII",R{x:hex.right()-85,y:hex.y+35,w:65,h:18},state.theme.muted,FontKind::MonoSmall,DT_LEFT|DT_SINGLELINE);
    let hex_lines=["00000000  45 4E 43 41 53 45 20 45  76 69 64 65 6E 63 65 20    ENCASE Evidence","00000010  46 69 6C 65 00 1A 00 00  01 00 00 00 00 00 00 00    File............","00000020  00 00 02 00 00 00 00 00  5A 2F 8C 3D 00 00 00 00    ........Z/.=....","00000030  00 00 00 00 00 00 00 00  FF EE DD CC BB AA 00 00    ................"];let mut y=hex.y+57;for s in &hex_lines{text(dc,&state.ui,s,R{x:hex.x+10,y,w:hex.w-20,h:17},state.theme.text,FontKind::MonoSmall,DT_LEFT|DT_SINGLELINE|DT_END_ELLIPSIS);y+=17;}
    let audit=R{x:r.x,y:hex.bottom()+7,w:r.w,h:(r.bottom()-hex.bottom()-7).max(85)}; panel(dc,audit,state.theme.panel,state.theme.border,6); text(dc,&state.ui,"▣  PostgreSQL Audit Summary",R{x:audit.x+12,y:audit.y+4,w:audit.w-130,h:28},state.theme.text,FontKind::Normal,DT_LEFT|DT_VCENTER|DT_SINGLELINE);let run=R{x:audit.right()-110,y:audit.y+6,w:92,h:28};panel(dc,run,state.theme.panel3,state.theme.border,5);text(dc,&state.ui,"↗  Run Audit",run,state.theme.text,FontKind::Small,DT_CENTER|DT_VCENTER|DT_SINGLELINE);
    let gap=6;let cw=(audit.w-20-gap*3)/4;let cards=[("Roles",state.case.audit.roles,state.theme.green),("Tables Exposed",state.case.audit.tables_exposed,state.theme.red),("Public Grants",state.case.audit.public_grants,state.theme.orange),("Risky Access",state.case.audit.risky_access,state.theme.red)];for(i,(label,val,color))in cards.iter().enumerate(){let c=R{x:audit.x+7+i as i32*(cw+gap),y:audit.y+42,w:cw,h:(audit.h-49).max(38)};fill(dc,c,rgb(9,25,29));stroke(dc,c,*color,1,5);text(dc,&state.ui,&val.to_string(),R{x:c.x,y:c.y+7,w:c.w,h:25},*color,FontKind::Big,DT_CENTER|DT_SINGLELINE);text(dc,&state.ui,label,R{x:c.x+2,y:c.y+33,w:c.w-4,h:18},*color,FontKind::Small,DT_CENTER|DT_SINGLELINE|DT_END_ELLIPSIS);}
}

#[derive(Clone,Copy)] enum FontKind { Normal, Small, Big, Mono, MonoSmall }
unsafe fn text(dc:HDC,ui:&UiResources,s:&str,r:R,color:COLORREF,font:FontKind,flags:UINT){
    let f=match font{FontKind::Normal=>ui.font_ui,FontKind::Small=>ui.font_ui_small,FontKind::Big=>ui.font_ui_big,FontKind::Mono=>ui.font_mono,FontKind::MonoSmall=>ui.font_mono_small};let old=SelectObject(dc,f);SetBkMode(dc,TRANSPARENT);SetTextColor(dc,color);let w=wide(s);let mut rc=r.rect();DrawTextW(dc,w.as_ptr(),(w.len()-1) as i32,&mut rc,flags|DT_NOPREFIX);SelectObject(dc,old);
}
unsafe fn fill(dc:HDC,r:R,color:COLORREF){let brush=GetStockObject(DC_BRUSH);let old_color=SetDCBrushColor(dc,color);let rc=r.rect();FillRect(dc,&rc,brush as HBRUSH);SetDCBrushColor(dc,old_color);}
unsafe fn stroke(dc:HDC,r:R,color:COLORREF,width:i32,radius:i32){
    let oldb=SelectObject(dc,GetStockObject(NULL_BRUSH));
    if width<=1{let pen=GetStockObject(DC_PEN);let oldp=SelectObject(dc,pen);let old_color=SetDCPenColor(dc,color);if radius>0{RoundRect(dc,r.x,r.y,r.right(),r.bottom(),radius,radius);}else{Rectangle(dc,r.x,r.y,r.right(),r.bottom());}SetDCPenColor(dc,old_color);SelectObject(dc,oldp);}else{let pen=CreatePen(PS_SOLID,width,color);let oldp=SelectObject(dc,pen);if radius>0{RoundRect(dc,r.x,r.y,r.right(),r.bottom(),radius,radius);}else{Rectangle(dc,r.x,r.y,r.right(),r.bottom());}SelectObject(dc,oldp);DeleteObject(pen);}
    SelectObject(dc,oldb);
}
unsafe fn panel(dc:HDC,r:R,bg:COLORREF,border:COLORREF,radius:i32){fill(dc,r,bg);stroke(dc,r,border,1,radius);}
unsafe fn line(dc:HDC,x1:i32,y1:i32,x2:i32,y2:i32,color:COLORREF,width:i32){if width<=1{let pen=GetStockObject(DC_PEN);let old=SelectObject(dc,pen);let old_color=SetDCPenColor(dc,color);MoveToEx(dc,x1,y1,null_mut());LineTo(dc,x2,y2);SetDCPenColor(dc,old_color);SelectObject(dc,old);}else{let p=CreatePen(PS_SOLID,width,color);let old=SelectObject(dc,p);MoveToEx(dc,x1,y1,null_mut());LineTo(dc,x2,y2);SelectObject(dc,old);DeleteObject(p);}}
unsafe fn dot(dc:HDC,cx:i32,cy:i32,r:i32,color:COLORREF){let brush=GetStockObject(DC_BRUSH);let pen=GetStockObject(DC_PEN);let oldb=SelectObject(dc,brush);let oldp=SelectObject(dc,pen);let oldbc=SetDCBrushColor(dc,color);let oldpc=SetDCPenColor(dc,color);Ellipse(dc,cx-r,cy-r,cx+r,cy+r);SetDCBrushColor(dc,oldbc);SetDCPenColor(dc,oldpc);SelectObject(dc,oldp);SelectObject(dc,oldb);}
unsafe fn ellipse_outline(dc:HDC,r:R,color:COLORREF,width:i32){let oldb=SelectObject(dc,GetStockObject(NULL_BRUSH));if width<=1{let pen=GetStockObject(DC_PEN);let oldp=SelectObject(dc,pen);let old_color=SetDCPenColor(dc,color);Ellipse(dc,r.x,r.y,r.right(),r.bottom());SetDCPenColor(dc,old_color);SelectObject(dc,oldp);}else{let pen=CreatePen(PS_SOLID,width,color);let oldp=SelectObject(dc,pen);Ellipse(dc,r.x,r.y,r.right(),r.bottom());SelectObject(dc,oldp);DeleteObject(pen);}SelectObject(dc,oldb);}
unsafe fn draw_sparkline(dc:HDC,r:R,vals:&VecDeque<u32>,color:COLORREF){if vals.len()<2{return;}let p=CreatePen(PS_SOLID,2,color);let old=SelectObject(dc,p);let step=r.w as f32/(vals.len()-1) as f32;for(i,v)in vals.iter().enumerate(){let x=r.x+(i as f32*step) as i32;let y=r.bottom()-((*v).min(100) as f32/100.0*r.h as f32) as i32;if i==0{MoveToEx(dc,x,y,null_mut());}else{LineTo(dc,x,y);}}SelectObject(dc,old);DeleteObject(p);}
unsafe fn sev_color(t:Theme,s:Severity)->COLORREF{match s{Severity::Critical=>t.red,Severity::High=>t.orange,Severity::Medium=>t.yellow,Severity::Low=>t.blue,Severity::Info=>rgb(121,164,202)}}

unsafe fn draw_arch_mark(dc:HDC,cx:i32,cy:i32,color:COLORREF){line(dc,cx-10,cy+14,cx,cy-16,color,3);line(dc,cx,cy-16,cx+11,cy+14,color,3);line(dc,cx-6,cy+4,cx+6,cy+4,color,2);}
unsafe fn draw_file_icon(dc:HDC,cx:i32,cy:i32,color:COLORREF){let r=R{x:cx-7,y:cy-9,w:14,h:18};stroke(dc,r,color,1,1);line(dc,cx-4,cy-3,cx+4,cy-3,color,1);line(dc,cx-4,cy+1,cx+4,cy+1,color,1);line(dc,cx-4,cy+5,cx+2,cy+5,color,1);}
unsafe fn draw_person(dc:HDC,cx:i32,cy:i32,color:COLORREF){dot(dc,cx,cy-5,4,color);let p=CreatePen(PS_SOLID,2,color);let old=SelectObject(dc,p);MoveToEx(dc,cx-7,cy+8,null_mut());LineTo(dc,cx-5,cy+2);LineTo(dc,cx+5,cy+2);LineTo(dc,cx+7,cy+8);SelectObject(dc,old);DeleteObject(p);}
unsafe fn draw_nav_icon(dc:HDC,item:NavItem,cx:i32,cy:i32,color:COLORREF){
    match item{
        NavItem::Dashboard=>{for(dx,dy)in[(-6,-6),(2,-6),(-6,2),(2,2)]{stroke(dc,R{x:cx+dx,y:cy+dy,w:5,h:5},color,1,1);}},
        NavItem::Cases=>{stroke(dc,R{x:cx-8,y:cy-5,w:16,h:11},color,1,2);line(dc,cx-4,cy-7,cx+4,cy-7,color,1);},
        NavItem::Evidence=>draw_file_icon(dc,cx,cy,color),
        NavItem::DiskImages|NavItem::PostgreSql=>{ellipse_outline(dc,R{x:cx-8,y:cy-8,w:16,h:6},color,1);line(dc,cx-8,cy-5,cx-8,cy+7,color,1);line(dc,cx+8,cy-5,cx+8,cy+7,color,1);ellipse_outline(dc,R{x:cx-8,y:cy+2,w:16,h:6},color,1);},
        NavItem::Memory=>{stroke(dc,R{x:cx-8,y:cy-7,w:16,h:14},color,1,2);for i in -2..=2{line(dc,cx-12,cy+i*3,cx-8,cy+i*3,color,1);line(dc,cx+8,cy+i*3,cx+12,cy+i*3,color,1);}},
        NavItem::Network=>{dot(dc,cx,cy-7,3,color);dot(dc,cx-7,cy+6,3,color);dot(dc,cx+7,cy+6,3,color);line(dc,cx,cy-4,cx-5,cy+3,color,1);line(dc,cx,cy-4,cx+5,cy+3,color,1);},
        NavItem::Logs=>{for i in -1..=1{line(dc,cx-8,cy+i*5,cx+8,cy+i*5,color,1);dot(dc,cx-10,cy+i*5,1,color);}},
        NavItem::Reports=>{draw_file_icon(dc,cx,cy,color);line(dc,cx-4,cy+5,cx+4,cy+5,color,2);},
        NavItem::Settings=>{dot(dc,cx,cy,7,color);dot(dc,cx,cy,3,rgb(4,14,18));for a in 0..4{let(dx,dy)=match a{0=>(0,-11),1=>(11,0),2=>(0,11),_=>(-11,0)};line(dc,cx+dx/2,cy+dy/2,cx+dx,cy+dy,color,2);}},
    }
