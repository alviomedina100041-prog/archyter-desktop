fn rgb(r: u8, g: u8, b: u8) -> COLORREF { r as u32 | ((g as u32) << 8) | ((b as u32) << 16) }
fn wide(s: &str) -> Vec<u16> { s.encode_utf16().chain(std::iter::once(0)).collect() }
fn loword(v: LPARAM) -> i32 { (v as u32 & 0xffff) as i16 as i32 }
fn hiword(v: LPARAM) -> i32 { ((v as u32 >> 16) & 0xffff) as i16 as i32 }
fn filetime_u64(v: FILETIME) -> u64 { ((v.dwHighDateTime as u64) << 32) | v.dwLowDateTime as u64 }

#[derive(Clone, Copy)]
struct R { x: i32, y: i32, w: i32, h: i32 }
impl R {
    fn right(self) -> i32 { self.x + self.w }
    fn bottom(self) -> i32 { self.y + self.h }
    fn contains(self, x: i32, y: i32) -> bool { x >= self.x && x < self.right() && y >= self.y && y < self.bottom() }
    fn inset(self, d: i32) -> Self { Self { x: self.x + d, y: self.y + d, w: self.w - d * 2, h: self.h - d * 2 } }
    fn rect(self) -> RECT { RECT { left: self.x, top: self.y, right: self.right(), bottom: self.bottom() } }
}

#[derive(Clone, Copy)]
struct Theme {
    bg: COLORREF,
    panel: COLORREF,
    panel2: COLORREF,
    panel3: COLORREF,
    border: COLORREF,
    border_soft: COLORREF,
    text: COLORREF,
    muted: COLORREF,
    faint: COLORREF,
    green: COLORREF,
    cyan: COLORREF,
    red: COLORREF,
    orange: COLORREF,
    yellow: COLORREF,
    blue: COLORREF,
}
impl Default for Theme {
    fn default() -> Self {
        Self {
            bg: rgb(4, 12, 16), panel: rgb(7, 18, 23), panel2: rgb(9, 23, 29), panel3: rgb(12, 29, 36),
            border: rgb(26, 48, 57), border_soft: rgb(17, 37, 45), text: rgb(222, 233, 238), muted: rgb(154, 171, 180),
            faint: rgb(95, 116, 125), green: rgb(0, 231, 118), cyan: rgb(0, 206, 230), red: rgb(255, 50, 74),
            orange: rgb(255, 112, 24), yellow: rgb(247, 205, 30), blue: rgb(53, 151, 255),
        }
    }
}

struct UiResources {
    font_ui: HFONT,
    font_ui_small: HFONT,
    font_ui_big: HFONT,
    font_mono: HFONT,
    font_mono_small: HFONT,
    icon: HICON,
}
impl UiResources {
    unsafe fn create() -> Self {
        fn font(face: &str, px: i32, weight: i32) -> HFONT {
            let face = wide(face);
            unsafe { CreateFontW(-px, 0, 0, 0, weight, 0, 0, 0, DEFAULT_CHARSET, 0, 0, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, face.as_ptr()) }
        }
        Self {
            font_ui: font("Segoe UI", 15, FW_NORMAL),
            font_ui_small: font("Segoe UI", 13, FW_NORMAL),
            font_ui_big: font("Segoe UI", 21, FW_SEMIBOLD),
            font_mono: font("Cascadia Mono", 14, FW_NORMAL),
            font_mono_small: font("Cascadia Mono", 12, FW_NORMAL),
            icon: null_mut(),
        }
    }
    unsafe fn destroy(&mut self) {
        for h in [self.font_ui, self.font_ui_small, self.font_ui_big, self.font_mono, self.font_mono_small] {
            if !h.is_null() { DeleteObject(h); }
        }
        if !self.icon.is_null() { DeleteObject(self.icon); }
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum NavItem { Dashboard, Cases, Evidence, DiskImages, Memory, Network, PostgreSql, Logs, Reports, Settings }
impl NavItem {
    const ALL: [NavItem; 10] = [Self::Dashboard, Self::Cases, Self::Evidence, Self::DiskImages, Self::Memory, Self::Network, Self::PostgreSql, Self::Logs, Self::Reports, Self::Settings];
    fn label(self) -> &'static str {
        match self {
            Self::Dashboard => "Dashboard", Self::Cases => "Cases", Self::Evidence => "Evidence", Self::DiskImages => "Disk Images",
            Self::Memory => "Memory Analysis", Self::Network => "Network Analysis", Self::PostgreSql => "PostgreSQL Audit",
            Self::Logs => "Logs", Self::Reports => "Reports", Self::Settings => "Settings",
        }
    }
}

