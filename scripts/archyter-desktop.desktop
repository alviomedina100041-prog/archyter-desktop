[Desktop Entry]
Type=Application
Name=Archyter Desktop
GenericName=Jupyter Desktop
Comment=JupyterLab integrado en una aplicación de escritorio para Arch Linux
Exec=bash -lc 'cd "__PROJECT_DIR__" && source .venv/bin/activate && python -m app.main'
Icon=__PROJECT_DIR__/assets/icon.svg
Terminal=false
Categories=Development;Science;IDE;
StartupNotify=true
