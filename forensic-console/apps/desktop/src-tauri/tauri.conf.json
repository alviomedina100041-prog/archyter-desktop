{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackArch Forensic Console",
  "version": "0.2.0",
  "identifier": "dev.blackarch.forensicconsole",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlackArch Forensic Console",
        "width": 1680,
        "height": 980,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
